{
  "name": "organization-api-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "XML OpenAPI contracts and static Swagger UI for two organization services",
  "engines": { "node": ">=22" },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run validate && node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test:ui": "npm run build && playwright test",
    "check": "npm run validate && npm test && npm run test:ui",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "dependencies": {
    "swagger-ui-dist": "5.32.15"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@playwright/test": "1.63.0",
    "ajv": "8.20.0",
    "fast-xml-parser": "5.11.1",
    "yaml": "2.9.1"
  }
}
